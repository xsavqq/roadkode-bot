# Токен бота от @BotFather
BOT_TOKEN=123456:ABC-DEF...

# Ваш Telegram ID (или ID группы), куда будут приходить заявки
# Узнать свой ID: напишите @userinfobot
MANAGER_CHAT_ID=123456789

# Формула расчёта: цена_юань * EXCHANGE_RATE * (1 + MARKUP_PERCENT/100) * количество
EXCHANGE_RATE=13.2
MARKUP_PERCENT=7

BOT_NAME=Cargo Hub

# Ссылки на закрытый чат/канал
CLOSED_CHAT_URL=https://t.me/+your_chat_invite
CLOSED_CHANNEL_URL=https://t.me/+your_channel_invite

DB_PATH=bot.db
